# Copy this file to .env in the repo root and fill in real values.
# .env is gitignored — never commit real secrets.
#
# This single file drives the whole stack (`docker compose up --build`
# from the repo root), because the root docker-compose.yml uses `include:`
# to pull in docker/elastic/docker-compose.yml as part of the same project.
# If you only want the Elastic stack standalone, docker/elastic/.env(.example)
# still works on its own with `docker compose -f docker/elastic/docker-compose.yml up -d`.

# --- Elasticsearch / Kibana ---
ELASTIC_PASSWORD=changeme
KIBANA_SYSTEM_PASSWORD=changeme
KIBANA_ENCRYPTION_KEY=min-32-chars-random-string-here
KIBANA_SO_ENCRYPTION_KEY=min-32-chars-random-string-here
KIBANA_REPORTING_KEY=min-32-chars-random-string-here

# --- Argus (behavior_detector, case_builder, API) ---
# ES_USER/ES_PASS authenticate against the same Elasticsearch above.
# ES_PASS should match ELASTIC_PASSWORD — see docker-compose.yml, where
# it's set to ${ELASTIC_PASSWORD} directly so you only maintain one value.
ES_USER=elastic

# Optional. Enables the Claude-narration endpoints in app.py
# (case briefs, hunt copilot). Everything else works without it.
CLAUDE_API_KEY=
